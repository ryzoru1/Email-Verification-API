# Application
APP_NAME="Email Verification API"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=false
LOG_LEVEL="INFO"

# API security (optional). When set, requests must include this key.
# For RapidAPI deployments you may rely on X-RapidAPI-Proxy-Secret instead.
API_KEY=""

# RapidAPI proxy secret (optional). If set, the API validates X-RapidAPI-Proxy-Secret.
RAPIDAPI_PROXY_SECRET=""

# Verification behavior
ENABLE_SMTP_CHECK=false
SMTP_TIMEOUT_SECONDS=10
DNS_TIMEOUT_SECONDS=5
MAX_BULK_EMAILS=100
REQUEST_TIMEOUT_SECONDS=30

# CORS
CORS_ALLOW_ORIGINS="*"
CORS_ALLOW_METHODS="*"
CORS_ALLOW_HEADERS="*"
